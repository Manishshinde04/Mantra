# ==============================================================================
# VOXFLOW — Environment Variables
# ==============================================================================

# Google Gemini API Key (Server-side only — NEVER expose to browser)
# Obtain your key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Rime AI (Primary Spoken-Output Provider — Server-side only)
# Sign up at https://rime.ai to get your API key
RIME_API_KEY=
RIME_MODEL=coda
RIME_SPEAKER=celeste
RIME_LANGUAGE=en
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_AUDIO_FORMAT=mp3
